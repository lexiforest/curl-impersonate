+  bool seen[kNumExtensions] = {};
+  const char *p = order_string;
+  size_t idx = 0;
+  while (*p != '\0') {
+    if (idx >= order.size() ||
+        !OPENSSL_isdigit(static_cast<unsigned char>(*p))) {
+      return ssl_invalid_extension_order();
+    }
