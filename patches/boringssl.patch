+// are rejected. Parsed private keys are checked for internal consistency.
+BSSL_WEBCRYPTO_EXPORT BSSL_WEBCRYPTO_KEY *bssl_webcrypto_key_parse(
+    int private_key, BSSL_WEBCRYPTO_SLICE der);
