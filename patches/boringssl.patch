+// in the order above, 20..22=EC x,y,d (padded to the curve coordinate width).
+BSSL_WEBCRYPTO_EXPORT int bssl_webcrypto_key_export(
+    const BSSL_WEBCRYPTO_KEY *key, int format, BSSL_WEBCRYPTO_BUFFER *out);
