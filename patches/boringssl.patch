+  size_t num_entries = order_string[0] == '\0' ? 0 : 1;
+  for (const char *p = order_string; *p != '\0'; p++) {
+    if (*p == '-' && ++num_entries > kNumExtensions) {
+      return ssl_invalid_extension_order();
+    }
+  }
